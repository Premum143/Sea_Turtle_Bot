      keywords: ['annual leave', 'earned leave', 'vacation', 'holiday days', 'leave days per year', 'how many days leave', 'how many leaves', 'leave entitlement', 'annual leave days', 'earned leave days', 'clubbed', 'carry forward', 'carry over', 'carryforward', 'pro rata', 'pro-rated', 'credited quarterly', 'leave policy', 'about leave', 'leave rules', 'tell me about leave', 'paid leave', 'paid leaves', 'paid time off', 'mid year', 'joining', 'prorated', 'unused', 'expire', 'lapse', 'credited', 'public holiday', 'holiday during', 'leave balance', 'leave year', 'calendar year', 'vacation days', 'yearly leave quota', 'quarter', 'per quarter', 'quarterly credited', 'each quarter', 'how many leaves per quarter'],
