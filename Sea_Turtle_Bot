      if (ALIASES[words[i]]) expanded = expanded.concat(ALIASES[words[i]].split(' '));
    }
    return expanded.join(' ');
  }

  function tokenize(text, keepStopWords) {
    return expandAliases(text)
      .split(' ')
      .map(stem)
      .filter(function(w) {
        return w && (keepStopWords || (!STOP_WORDS.has(w) && (w.length > 1 || /\d/.test(w))));
      });
  }

  function tokenSet(tokens) {
    return new Set(tokens);
  }

  function editDistance(a, b) {
    if (Math.abs(a.length - b.length) > 1) return 2;
    if (a === b) return 0;
    var edits = 0;
    var i = 0;
    var j = 0;
    while (i < a.length && j < b.length) {
      if (a[i] === b[j]) {
        i++;
        j++;
      } else {
        edits++;
        if (edits > 1) return edits;
        if (a.length > b.length) i++;
        else if (b.length > a.length) j++;
        else {
          i++;
          j++;
        }
      }
    }
    if (i < a.length || j < b.length) edits++;
    return edits;
  }

  function hasToken(set, token) {
    if (set.has(token)) return true;
    if (token.length < 5) return false;
    var found = false;
    set.forEach(function(candidate) {
      if (!found && candidate.length >= 5 && editDistance(token, candidate) <= 1) found = true;
    });
    return found;
  }

  function stripHtml(html) {
    return html.replace(/<[^>]*>/g, ' ');
  }

  function categoryWords(category) {
    return category ? tokenize(category, false) : [];
  }

  var QA_BY_ENTRY = {};
  QA_BANK.forEach(function(item) {
    if (!QA_BY_ENTRY[item.answerId]) QA_BY_ENTRY[item.answerId] = [];
    QA_BY_ENTRY[item.answerId].push(item.question);
  });

  KB.forEach(function(entry) {
    var generatedQuestions = QA_BY_ENTRY[entry.id] || [];
    var searchable = [entry.id.replace(/-/g, ' '), entry.category || '', stripHtml(entry.answer)]
      .concat(entry.keywords, generatedQuestions)
      .join(' ');
    entry._tokens = tokenize(searchable, false);
    entry._tokenSet = tokenSet(entry._tokens);
    entry._categorySet = tokenSet(categoryWords(entry.category));
    entry._keywordData = entry.keywords.concat(generatedQuestions).map(function(keyword) {
      return {
        raw: normalize(keyword),
        expanded: expandAliases(keyword),
        tokens: tokenize(keyword, false)
      };
    });
  });

  function findEntryById(id) {
    for (var i = 0; i < KB.length; i++) {
      if (KB[i].id === id) return KB[i];
    }
    return null;
  }

  var QA_EXACT = {};
  QA_BANK.forEach(function(item) {
    QA_EXACT[normalize(item.question)] = item.answerId;
  });

  function hasAny(text, terms) {
    return terms.some(function(term) { return text.indexOf(term) !== -1; });
  }

  function intentMatch(question) {
    var text = ' ' + expandAliases(question) + ' ';
    var entry = null;

    if (hasAny(text, [' lwp ', ' lop ', ' leave without pay ', ' unpaid leave ', ' without pay '])) entry = findEntryById('lwp');
    else if (hasAny(text, [' fnf ', ' ff ', ' full final ', ' full and final ', ' final settlement '])) entry = findEntryById('exit-ff-settlement');
    else if (hasAny(text, [' notice period ', ' np ', ' serving notice ']) && hasAny(text, [' day ', ' days ', ' duration ', ' length ', ' long ', ' kitna ', ' kitne '])) entry = findEntryById('exit-notice-period');
    else if (hasAny(text, [' icc ', ' internal complaints committee ', ' posh committee ']) && hasAny(text, [' member ', ' members ', ' contact ', ' kaun ', ' who '])) entry = findEntryById('posh-icc');
    else if ((hasAny(text, [' false ', ' malicious ', ' fake ', ' wrongful ', ' fabricated ']) && hasAny(text, [' complaint ', ' allegation ', ' accusation '])) || hasAny(text, [' false complaint ', ' malicious complaint ', ' fake complaint ', ' wrongful allegation ', ' false accusation ', ' fabricated complaint '])) entry = findEntryById('posh-false-complaint');
    else if (hasAny(text, [' posh ', ' sexual harassment ', ' harassment complaint ']) && hasAny(text, [' after ', ' process ', ' investigation ', ' inquiry ', ' timeline ', ' complaint process ', ' what happens '])) entry = findEntryById('posh-process');
    else if (hasAny(text, [' level 3 ', ' gross misconduct ', ' theft ', ' stealing ', ' chori ', ' physical violence ', ' drugs ', ' alcohol ', ' data breach ', ' hacking ', ' forgery ', ' police '])) entry = findEntryById('coc-level3-gross');
    else if (hasAny(text, [' level 2 ', ' moderate misconduct ', ' abusive language ', ' unauthorized information ', ' repeated level 1 '])) entry = findEntryById('coc-level2-moderate');
    else if (hasAny(text, [' level 1 ', ' minor misconduct ', ' late coming ', ' early leaving ', ' poor attendance '])) entry = findEntryById('coc-level1-minor');
    else if (hasAny(text, [' joined mid year ', ' mid year ', ' pro rata ', ' prorated ', ' joined in ', ' join after ', ' joining after '])) entry = findEntryById('leave-mid-year-pro-rata');
    else if (hasAny(text, [' carry forward ', ' carry over ', ' carryforward ', ' balance ', ' unused ', ' lapse ', ' expire ']) && hasAny(text, [' leave ', ' chutti ', ' chhutti '])) entry = findEntryById('leave-balance');
    else if (hasAny(text, [' weekend count ', ' sunday count ', ' holiday count ', ' weekly off count ', ' public holiday leave ', ' do weekends count ', ' do holidays count '])) entry = findEntryById('leave-count-weekends');
    else if (hasAny(text, [' miscarriage ', ' miscariage ', ' medical termination pregnancy ', ' pregnancy loss ', ' mtp '])) entry = findEntryById('miscarriage-leave');
    else if (hasAny(text, [' maternity ', ' maternaty ', ' pregnancy ', ' delivery '])) entry = findEntryById('maternity-leave');
    else if (hasAny(text, [' paternity ', ' paternaty ', ' father leave ', ' new dad '])) entry = findEntryById('paternity-leave');
    else if (hasAny(text, [' shadi ', ' shaadi ', ' vivah ', ' marriage ', ' wedding '])) entry = findEntryById('marriage-leave');
    else if (hasAny(text, [' advance ', ' salary advance ', ' advance salary ', ' salary loan ', ' advance money ', ' paisa ', ' paise ']) && hasAny(text, [' reason ', ' purpose ', ' medical ', ' emergency ', ' wedding ', ' marriage ', ' education ', ' home repair ', ' travel ', ' family '])) entry = findEntryById('sa-reasons');
    else if (hasAny(text, [' advance ', ' salary advance ', ' advance salary ', ' salary loan ', ' advance money ', ' paisa ', ' paise ']) && hasAny(text, [' limit ', ' maximum ', ' how much ', ' kitna ', ' amount ', ' cap ', ' ctc '])) entry = findEntryById('sa-limit');
    else if (hasAny(text, [' advance ', ' salary advance ', ' advance salary ', ' salary loan ', ' advance money ', ' paisa ', ' paise ']) && hasAny(text, [' eligible ', ' eligibility ', ' probation ', ' intern ', ' contractor ', ' new employee ', ' tenure '])) entry = findEntryById('sa-eligibility');
    else if (hasAny(text, [' advance ', ' salary advance ', ' advance salary ', ' salary loan ', ' advance money ', ' paisa ', ' paise ']) && hasAny(text, [' approve ', ' approves ', ' approval ', ' authority ', ' director ', ' finance ', ' hr '])) entry = findEntryById('sa-approval-authority');
    else if (hasAny(text, [' advance ', ' salary advance ', ' advance salary ', ' salary loan ', ' advance money ', ' paisa ', ' paise ']) && hasAny(text, [' disburse ', ' disbursed ', ' disbursement ', ' credited ', ' processing time ', ' how many days ', ' kab tak ', ' working days '])) entry = findEntryById('sa-processing-time');
    else if (hasAny(text, [' advance ', ' salary advance ', ' advance salary ', ' salary loan ', ' advance money ', ' paisa ', ' paise ']) && hasAny(text, [' recover ', ' recovered ', ' recovery ', ' repay ', ' repayment ', ' deduction ', ' deductions ', ' emi ', ' payroll ', ' 6 months '])) entry = findEntryById('sa-recovery-repayment');
    else if (hasAny(text, [' advance ', ' salary advance ', ' advance salary ', ' salary loan ', ' advance money ', ' paisa ', ' paise ']) && hasAny(text, [' document ', ' documents ', ' proof ', ' bill ', ' bills ', ' receipt ', ' receipts ', ' evidence ', ' attach ', ' attachment '])) entry = findEntryById('sa-documentation');
    else if (hasAny(text, [' advance ', ' salary advance ', ' advance salary ', ' salary loan ', ' advance money ', ' paisa ', ' paise ']) && hasAny(text, [' tax ', ' taxable ', ' tds ', ' compliance ', ' statutory '])) entry = findEntryById('sa-tax');
    else if (hasAny(text, [' advance ', ' salary advance ', ' advance salary ', ' salary loan ', ' advance money ', ' paisa ', ' paise ']) && hasAny(text, [' portal ', ' form ', ' annexure ', ' request form '])) entry = findEntryById('sa-portal-access');
    else if (hasAny(text, [' advance ', ' salary advance ', ' advance salary ', ' salary loan ', ' advance money ', ' paisa ', ' paise ']) && hasAny(text, [' misuse ', ' misrepresentation ', ' false ', ' forged ', ' fraudulent ', ' concealment ', ' wrong information '])) entry = findEntryById('sa-misconduct');
    else if (hasAny(text, [' advance ', ' salary advance ', ' advance salary ', ' salary loan ', ' advance money ', ' paisa ', ' paise ']) && hasAny(text, [' resign ', ' resignation ', ' separation ', ' terminate ', ' termination ', ' retirement ', ' abscond ', ' outstanding ', ' leaving ', ' notice period '])) entry = findEntryById('sa-separation');
    else if (hasAny(text, [' advance ', ' salary advance ', ' advance salary ', ' salary loan ', ' advance money ', ' paisa ', ' paise ']) && hasAny(text, [' apply ', ' application ', ' form ', ' portal ', ' process ', ' kaise '])) entry = findEntryById('sa-application-process');
    else if (hasAny(text, [' staring ', ' stare ', ' leering ', ' ogling ', ' unwanted gaze ', ' unwanted attention ']) && hasAny(text, [' harassment ', ' posh ', ' uncomfortable '])) entry = findEntryById('posh-staring');
    else if (hasAny(text, [' fraud ', ' theft ', ' misconduct ', ' violation ', ' data breach ']) && hasAny(text, [' report ', ' escalate ', ' where ', ' kahan ', ' whom ', ' email '])) entry = findEntryById('coc-escalation');
    else if (hasAny(text, [' grievance ', ' grivance ', ' grevance ']) && hasAny(text, [' confidential ', ' confidentiality ', ' private ', ' identity ', ' anonymous '])) entry = findEntryById('grievance-confidentiality');
    else if (hasAny(text, [' grievance ', ' grivance ', ' grevance ']) && hasAny(text, [' committee ', ' members ', ' who ', ' kaun '])) entry = findEntryById('grievance-committee');
    else if (hasAny(text, [' grievance ', ' grivance ', ' grevance ']) && hasAny(text, [' timeline ', ' acknowledge ', ' acknowledgement ', ' resolve ', ' resolution ', ' 2 working ', ' 7 10 '])) entry = findEntryById('grievance-timeline');
    else if (hasAny(text, [' unfair treatment ', ' supervisor ', ' manager ', ' workload ', ' workplace conflict ', ' payroll ', ' infrastructure ', ' facilities ', ' role clarity ']) && hasAny(text, [' grievance ', ' grivance ', ' grevance ', ' complaint ', ' complain ', ' where ', ' how ', ' kahan ', ' kisko '])) {
      entry = hasAny(text, [' where ', ' how ', ' kahan ', ' kisko ', ' raise ', ' submit ']) ? findEntryById('grievance-procedure') : findEntryById('grievance-types');
    }

    return entry ? { answer: entry.answer, tag: entry.category } : null;
  }

  function addMessage(text, role, sourceTag) {
    var div = document.createElement('div');
    div.className = 'message ' + role;
    var label = document.createElement('div');
    label.className = 'msg-label';
    label.textContent = role === 'bot' ? 'Turtle' : 'You';
    div.appendChild(label);
    var content = document.createElement('div');
    content.innerHTML = text;
    div.appendChild(content);
    if (role === 'bot' && sourceTag) {
      var tag = document.createElement('div');
      tag.className = 'source-tag ' + sourceTag.toLowerCase();
      tag.textContent = sourceTag;
      div.appendChild(tag);
    }
    if (role === 'bot') {
      var typing = document.querySelector('.typing-indicator');
      if (typing) typing.classList.remove('show');
    }
    chatArea.insertBefore(div, typingIndicator);
    scrollToBottom();
  }

  function showTyping() { typingIndicator.classList.add('show'); scrollToBottom(); }
  function hideTyping() { typingIndicator.classList.remove('show'); }

  function getAnswer(question) {
    var q = normalize(question);
    var expandedQ = expandAliases(question);
    var words = q.split(' ').filter(function(w) { return w; });
    var queryTokens = tokenize(question, false);
    var querySet = tokenSet(queryTokens);

    var isEngGreeting = words.length <= 5 && (
      words.some(function(w) { return GREETINGS.indexOf(w) !== -1; }) ||
      GREETINGS.some(function(g) { return g.indexOf(' ') !== -1 && q.indexOf(g) !== -1; })
    );
    if (q.indexOf('how are thing') !== -1 || q.indexOf('how are you') !== -1 || q.indexOf('how is it going') !== -1 || q.indexOf('whats up') !== -1) {
      return { answer: GREETING_RESPONSE, tag: null };
    }
    if (isEngGreeting) return { answer: GREETING_RESPONSE, tag: null };

    for (var i = 0; i < REDIRECT_KEYWORDS.length; i++) {
      if (q.indexOf(REDIRECT_KEYWORDS[i]) !== -1) return { answer: REDIRECT_RESPONSE, tag: null };
    }

    if (!queryTokens.length) return { answer: FALLBACK, tag: null };

    if (q === 'policy' || q === 'policies' || q === 'policy list' || q === 'list policy' || q === 'list policies') {
      var policyListEntry = findEntryById('what-policies');
      if (policyListEntry) return { answer: policyListEntry.answer, tag: policyListEntry.category, id: policyListEntry.id };
    }

    var intentResult = intentMatch(question);
    if (intentResult) return intentResult;

    if (QA_EXACT[q]) {
      var exactEntry = findEntryById(QA_EXACT[q]);
      if (exactEntry) return { answer: exactEntry.answer, tag: exactEntry.category };
    }

    var bestScore = 0;
    var bestEntry = null;
    var secondBestScore = 0;

    for (var ki = 0; ki < KB.length; ki++) {
      var entry = KB[ki];
      if (entry.category === null) {
        var hasExactMetaMatch = entry.keywords.some(function(keyword) {
          var normalizedKeyword = normalize(keyword);
          return normalizedKeyword && (q === normalizedKeyword || q.indexOf(normalizedKeyword) !== -1);
        });
        if (!hasExactMetaMatch) continue;
      }
      var score = 0;
      var matchedTokens = 0;
      var categoryMatches = 0;

      querySet.forEach(function(token) {
        if (hasToken(entry._tokenSet, token)) matchedTokens++;
        if (hasToken(entry._categorySet, token)) categoryMatches++;
      });

      if (matchedTokens) {
        score += (matchedTokens / queryTokens.length) * 8;
        score += Math.min(matchedTokens, 6) * 0.55;
      }

      if (categoryMatches) score += categoryMatches * 1.4;

      for (var kj = 0; kj < entry._keywordData.length; kj++) {
        var kw = entry._keywordData[kj];
        if (!kw.tokens.length) continue;
        var kwMatches = kw.tokens.filter(function(token) { return hasToken(querySet, token); }).length;
        var coverage = kwMatches / kw.tokens.length;

        if (kw.raw && q.indexOf(kw.raw) !== -1) score += 14 + Math.min(kw.tokens.length, 8);
        else if (kw.expanded && expandedQ.indexOf(kw.expanded) !== -1) score += 10 + Math.min(kw.tokens.length, 6);
        else if (coverage === 1) score += 7 + Math.min(kw.tokens.length, 6);
        else if (coverage >= 0.67 && kwMatches >= 2) score += 4 * coverage;
        else if (coverage >= 0.5 && kwMatches >= 2) score += 2.2 * coverage;
      }

      if (entry.category === null && matchedTokens < 2 && queryTokens.length > 2) score *= 0.7;
      if (score > bestScore) {
        secondBestScore = bestScore;
        bestScore = score;
        bestEntry = entry;
      } else if (score > secondBestScore) {
        secondBestScore = score;
      }
    }

    if (bestEntry && bestScore >= 6 && (bestScore - secondBestScore >= 1.2 || bestScore >= 12)) {
      return { answer: bestEntry.answer, tag: bestEntry.category };
    }
    if (bestEntry && bestScore >= 3.2) return { answer: LOW_CONFIDENCE_RESPONSE, tag: null };
    return { answer: FALLBACK, tag: null };
  }

  function handleQuestion(question) {
    if (!question.trim() || isProcessing) return;
    isProcessing = true;
    sendBtn.disabled = true;
    inputField.disabled = true;
    var qText = question.trim();
    addMessage(escapeHtml(qText), 'user');
    inputField.value = '';
    inputField.style.height = 'auto';
    showTyping();
    setTimeout(function() {
      var result = getAnswer(qText);
      hideTyping();
      addMessage(result.answer, 'bot', result.tag);
      isProcessing = false;
      sendBtn.disabled = false;
      inputField.disabled = false;
      inputField.focus();
    }, 400 + Math.random() * 400);
  }

  sendBtn.addEventListener('click', function() { handleQuestion(inputField.value); });
  inputField.addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); if (!isProcessing) handleQuestion(inputField.value); }
  });
  inputField.addEventListener('input', function() {
    inputField.style.height = 'auto';
    inputField.style.height = Math.min(inputField.scrollHeight, 120) + 'px';
  });
  window.sendSuggestion = function(btn) { if (!isProcessing) handleQuestion(btn.textContent); };
  inputField.focus();
})();
</script>
