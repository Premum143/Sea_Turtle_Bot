  <div class="chat-area" id="chatArea" role="log" aria-live="polite">
    <div class="typing-indicator" id="typingIndicator">
      <span></span><span></span><span></span>
    </div>
  </div>
  <div class="input-area">
    <div class="input-row">
      <textarea id="inputField" placeholder="Type your question here..." rows="1" aria-label="Ask a policy question"></textarea>
      <button class="send-btn" id="sendBtn" aria-label="Send message">&#x2191;</button>
    </div>
  </div>
  <div class="disclaimer">For official policy documents or urgent matters, contact HR at <strong>hr@zouk.co.in</strong>.</div>
</div>
<script>
